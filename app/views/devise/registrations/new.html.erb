<div class="login-container">
  <h2 class="login-heading">Sign Up</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "login-form" }) do |f| %>
    
    <div class="login-field">
      <%= f.label :email, class: "login-label" %>
      <%= f.email_field :email, autofocus: true, class: "login-input" %>
    </div>

    <div class="login-field">
      <%= f.label :password, class: "login-label" %>
      <%= f.password_field :password, class: "login-input" %>
    </div>

    <div class="login-field">
      <%= f.label :password_confirmation, class: "login-label" %>
      <%= f.password_field :password_confirmation, class: "login-input" %>
    </div>

    <div class="login-field">
      <%= f.label :contact_number, "Contact Number", class: "login-label" %>
      <%= f.text_field :contact_number, class: "login-input" %>
    </div>

    <div class="login-field">
      <%= f.label :role, "Register as", class: "login-label" %>
      <%= f.select :role, [["Renter", 0], ["Owner", 1]], {}, class: "login-input" %>
    </div>

    <div class="login-field">
      <%= f.submit "Sign Up", class: "login-submit" %>
    </div>

  <% end %>

  <div class="login-links">
    <%= render "devise/shared/links" %>
  </div>
</div>
