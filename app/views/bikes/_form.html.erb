<%= form_with(model: @bike, local: true, html: { class: "bike-form" }) do |f| %>

  <div class="bike-form-field">
    <%= f.label :name, class: "bike-form-label" %>
    <%= f.text_field :name, class: "bike-form-input", placeholder: "Enter bike name" %>
  </div>

  <div class="bike-form-field">
    <%= f.label :engine, class: "bike-form-label" %>
    <%= f.text_field :engine, class: "bike-form-input", placeholder: "e.g., 150cc" %>
  </div>

  <div class="bike-form-field">
    <%= f.label :start_power, "Start Power", class: "bike-form-label" %>
    <%= f.text_field :start_power, class: "bike-form-input", placeholder: "e.g., Self Start" %>
  </div>

  <div class="bike-form-field">
    <%= f.label :model_year, "Model Year", class: "bike-form-label" %>
    <%= f.number_field :model_year, class: "bike-form-input", placeholder: "e.g., 2022" %>
  </div>

  <div class="bike-form-field">
    <%= f.label :price_per_day, "Price per Day", class: "bike-form-label" %>
    <%= f.number_field :price_per_day, class: "bike-form-input", step: 0.01, placeholder: "e.g., 350" %>
  </div>

  <div class="bike-form-field">
    <%= f.label :image, "Bike Image", class: "bike-form-label" %>
    <%= f.file_field :image, class: "bike-form-input" %>

    <% if @bike.image.attached? %>
      <p class="bike-form-current-image-label">Current Image:</p>
      <%= image_tag @bike.image.variant(resize_to_limit: [400, 250]), class: "bike-form-current-image" %>
    <% end %>
  </div>

  <div class="bike-form-actions">
    <%= f.submit "Save Bike", class: "bike-form-submit" %>
    <%= link_to "Back", bikes_path, class: "bike-form-back" %>
  </div>

<% end %>
